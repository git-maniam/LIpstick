<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="LIpstick_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LIpstick_App"
    xmlns:models="using:LIpstick.Core.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="LIpstick - Windows Modern UI for LinkedIn"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom TitleBar with App Branding, Model Selector, and Theme Switcher -->
        <TitleBar
            x:Name="AppTitleBar"
            Title="LIpstick"
            Subtitle="LinkedIn Polish &amp; Humanizer"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested"
            BackRequested="TitleBar_BackRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/LIpstick-Logo.png" />
            </TitleBar.IconSource>

            <TitleBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,0,140,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="Model:" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                        <ComboBox
                            x:Name="ModelSelector"
                            Width="260"
                            FontSize="12"
                            ItemsSource="{x:Bind ViewModel.AvailableModels, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedModelInfo, Mode=TwoWay}"
                            SelectionChanged="ModelSelector_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:ModelInfo">
                                    <StackPanel Orientation="Vertical" Spacing="1">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{x:Bind MetadataSummary}" FontSize="10" Opacity="0.7" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Button
                        x:Name="ThemeToggleButton"
                        ToolTipService.ToolTip="Toggle Light / Dark Theme"
                        Click="ThemeToggleButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,4">
                        <FontIcon Glyph="&#xE706;" FontSize="14" />
                    </Button>
                </StackPanel>
            </TitleBar.Content>
        </TitleBar>

        <!-- Navigation Shell -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="220"
            CompactPaneLength="54"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Connections" Tag="connect" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Scanner" Tag="scan">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Improve" Tag="diff">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Content Lab" Tag="content">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE82D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Persistent Sidebar Account Controls (SPEC 2.0.2 / 2.0.3) -->
            <NavigationView.PaneHeader>
                <StackPanel Spacing="6" Margin="10,0,10,12">
                    <Border Background="#100A66C2" CornerRadius="6" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.LinkedInStatusBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.LinkedInStatus, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="LinkedIn" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#1010A37F" CornerRadius="6" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.OpenAiStatusBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.OpenAiStatus, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="OpenAI" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#104285F4" CornerRadius="6" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.GeminiStatusBrush, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.GeminiStatus, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="Gemini" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </NavigationView.PaneHeader>

            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
