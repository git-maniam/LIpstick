<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LIpstick_App.Pages.ConnectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="#F3F6FD" VerticalScrollBarVisibility="Auto">
        <Grid Padding="30,26,30,32">
            <StackPanel Spacing="18" MaxWidth="1080" HorizontalAlignment="Stretch">
                <StackPanel Spacing="3">
                    <TextBlock Text="Connections" FontSize="30" FontWeight="Bold" Foreground="#14264F" />
                    <TextBlock Text="Connect your accounts and AI providers to unlock all features." FontSize="15" Foreground="#53678E" />
                </StackPanel>

                <Border Background="#E5EEFF" BorderBrush="#CCDDFE" BorderThickness="1" CornerRadius="12" Padding="16,13">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" FontSize="18" Foreground="#2874E8" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="The model dropdown needs at least one AI provider connected (OpenAI or Gemini). Connect either provider, or both, and choose your preferred model." TextWrapping="Wrap" Foreground="#213B69" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- LinkedIn connection -->
                <Border Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#E7F1FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71B;" FontSize="26" Foreground="#0A66C2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="LinkedIn" FontSize="17" FontWeight="SemiBold" Foreground="#17284D" />
                            <TextBlock Text="Connect your profile to scan, improve, and create content." FontSize="12" Foreground="#566A8E" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.LinkedInUser, Mode=OneWay}" FontSize="12" Foreground="#344A70" />
                            <TextBlock Text="{x:Bind ViewModel.LinkedInStatusMessage, Mode=OneWay}" FontSize="11" Foreground="#667796" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{x:Bind ViewModel.IsLinkedInConnected, Mode=OneWay, Converter={StaticResource ConnectionColorConverter}}" CornerRadius="14" Padding="10,5">
                                <TextBlock Text="Profile setup" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Button Content="Open LinkedIn Login" Command="{x:Bind ViewModel.ToggleLinkedInConnectionCommand}" MinWidth="150" />
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Header="Your LinkedIn profile URL" PlaceholderText="https://www.linkedin.com/in/your-name/" Text="{x:Bind ViewModel.LinkedInProfileUrl, Mode=TwoWay}" />
                            <Button Grid.Column="1" Content="Save Profile URL" Command="{x:Bind ViewModel.SaveLinkedInProfileUrlCommand}" VerticalAlignment="Bottom" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Gemini connection -->
                <Border Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#EDF2FF" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8D4;" FontSize="25" Foreground="#6485F5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="Google Gemini" FontSize="17" FontWeight="SemiBold" Foreground="#17284D" />
                            <TextBlock Text="Use Gemini models for profile analysis and content generation." FontSize="12" Foreground="#566A8E" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.GeminiStatusMessage, Mode=OneWay}" FontSize="11" Foreground="#667796" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{x:Bind ViewModel.IsGeminiConnected, Mode=OneWay, Converter={StaticResource ConnectionColorConverter}}" CornerRadius="14" Padding="10,5">
                                <TextBlock Text="{x:Bind ViewModel.IsGeminiConnected, Mode=OneWay, Converter={StaticResource BoolToConnectedTextConverter}}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Button Content="{x:Bind ViewModel.IsGeminiConnected, Mode=OneWay, Converter={StaticResource BoolToDisconnectButtonTextConverter}}" Command="{x:Bind ViewModel.DisconnectGeminiCommand}" MinWidth="92" Visibility="{x:Bind ViewModel.IsGeminiConnected, Mode=OneWay}" />
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="10" Visibility="{x:Bind ViewModel.IsGeminiConnected, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox PlaceholderText="Enter Google AI Studio / Gemini API key" Password="{x:Bind ViewModel.GeminiApiKey, Mode=TwoWay}" />
                            <Button Grid.Column="1" Content="Save &amp; Connect" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveGeminiKeyCommand}" VerticalAlignment="Bottom" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- OpenAI connection -->
                <Border Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Width="48" Height="48" CornerRadius="10" Background="#EAF7F4" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE946;" FontSize="25" Foreground="#10A37F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="OpenAI" FontSize="17" FontWeight="SemiBold" Foreground="#17284D" />
                            <TextBlock Text="Use OpenAI models to improve your profile and generate content." FontSize="12" Foreground="#566A8E" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.OpenAiStatusMessage, Mode=OneWay}" FontSize="11" Foreground="#667796" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{x:Bind ViewModel.IsOpenAiConnected, Mode=OneWay, Converter={StaticResource ConnectionColorConverter}}" CornerRadius="14" Padding="10,5">
                                <TextBlock Text="{x:Bind ViewModel.IsOpenAiConnected, Mode=OneWay, Converter={StaticResource BoolToConnectedTextConverter}}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <Button Content="Disconnect" Command="{x:Bind ViewModel.DisconnectOpenAiCommand}" MinWidth="92" Visibility="{x:Bind ViewModel.IsOpenAiConnected, Mode=OneWay}" />
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ColumnSpacing="10" Visibility="{x:Bind ViewModel.IsOpenAiConnected, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox PlaceholderText="Enter OpenAI API key" Password="{x:Bind ViewModel.OpenAiApiKey, Mode=TwoWay}" />
                            <Button Grid.Column="1" Content="Save &amp; Connect" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveOpenAiKeyCommand}" VerticalAlignment="Bottom" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
