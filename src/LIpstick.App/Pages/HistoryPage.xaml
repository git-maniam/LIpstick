<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LIpstick_App.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LIpstick.Core.Models"
    mc:Ignorable="d">

    <Grid Background="#F3F6FD" Padding="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="3" Margin="0,0,0,14">
            <TextBlock Text="Change History" FontSize="30" FontWeight="Bold" Foreground="#14264F" />
            <TextBlock Text="Review and restore past changes to your profile and content." FontSize="14" Foreground="#53678E" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Section" FontSize="11" FontWeight="SemiBold" Foreground="#53678E" />
                <ComboBox ItemsSource="{x:Bind ViewModel.Sections}" SelectedItem="{x:Bind ViewModel.SectionFilter, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Date" FontSize="11" FontWeight="SemiBold" Foreground="#53678E" />
                <ComboBox ItemsSource="{x:Bind ViewModel.DateRanges}" SelectedItem="{x:Bind ViewModel.DateFilter, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Status" FontSize="11" FontWeight="SemiBold" Foreground="#53678E" />
                <ComboBox ItemsSource="{x:Bind ViewModel.Statuses}" SelectedItem="{x:Bind ViewModel.StatusFilter, Mode=TwoWay}" />
            </StackPanel>
            <Button Grid.Column="3" Content="Reset" Command="{x:Bind ViewModel.ResetFiltersCommand}" VerticalAlignment="Bottom" />
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="14" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Padding="8,8" ColumnSpacing="12" Background="#F1F5FD">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="100" /><ColumnDefinition Width="84" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Time · Section" FontWeight="SemiBold" FontSize="11" Foreground="#314A76" />
                    <TextBlock Grid.Column="1" Text="Previous text" FontWeight="SemiBold" FontSize="11" Foreground="#314A76" />
                    <TextBlock Grid.Column="2" Text="Applied text" FontWeight="SemiBold" FontSize="11" Foreground="#314A76" />
                    <TextBlock Grid.Column="3" Text="Score" FontWeight="SemiBold" FontSize="11" Foreground="#314A76" />
                    <TextBlock Grid.Column="4" Text="Status" FontWeight="SemiBold" FontSize="11" Foreground="#314A76" />
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.FilteredHistoryItems, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProfileHistoryItem">
                            <Grid Padding="8,10" ColumnSpacing="12" BorderBrush="#E1E8F3" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="100" /><ColumnDefinition Width="84" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind SectionName}" FontWeight="SemiBold" FontSize="12" Foreground="#1B2E55" />
                                    <TextBlock Text="{x:Bind FormattedTimestamp}" FontSize="10" Foreground="#71819C" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{x:Bind PreviousText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center" Foreground="#53678E" />
                                <TextBlock Grid.Column="2" Text="{x:Bind AppliedText}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center" Foreground="#263C67" />
                                <Border Grid.Column="3" Background="#E7F6ED" CornerRadius="10" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{x:Bind FormattedHumanScore}" FontWeight="Bold" FontSize="11" Foreground="#226748" />
                                </Border>
                                <Border Grid.Column="4" Background="#E7F6ED" CornerRadius="10" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{x:Bind Status}" FontSize="10" Foreground="#226748" />
                                </Border>
                                <Button Grid.Column="5" Content="Restore" VerticalAlignment="Center" Click="RestoreButton_Click" Tag="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="1" Text="No saved changes match these filters." FontSize="13" Foreground="#71819C" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.HasHistory, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontWeight="SemiBold" Foreground="#2874E8" FontSize="12" Margin="2,8,0,0" />
    </Grid>
</Page>
