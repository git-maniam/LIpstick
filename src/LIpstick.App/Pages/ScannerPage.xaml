<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LIpstick_App.Pages.ScannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LIpstick.Core.Models"
    mc:Ignorable="d">

    <ScrollViewer Background="#F3F6FD" Padding="28,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="Profile Scanner" FontSize="30" FontWeight="Bold" Foreground="#14264F" />
                    <TextBlock Text="Analyze your profile against a 12-category best-practice rubric and get a clear, prioritized result." FontSize="14" Foreground="#53678E" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.ScanProfileCommand}" Padding="18,10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Foreground="White" />
                        <FontIcon Glyph="&#xE72C;" FontSize="15" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                        <TextBlock Text="{x:Bind ViewModel.ScanButtonLabel, Mode=OneWay}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="16" Padding="24">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="136" Height="136" CornerRadius="68" BorderThickness="9" BorderBrush="#83AEF7" Background="#EEF4FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="-4">
                            <TextBlock Text="{x:Bind ViewModel.TotalScore, Mode=OneWay}" FontSize="44" FontWeight="Bold" Foreground="#14264F" HorizontalAlignment="Center" />
                            <TextBlock Text="/100" FontSize="16" Foreground="#53678E" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="12">
                        <Border Background="#FDE7E9" CornerRadius="10" Padding="12,7" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Bind ViewModel.ScoreVerdict, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="#9B2634" />
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="15" Foreground="#30466D" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ProfileHeadline, Mode=OneWay}" FontSize="14" Foreground="#53678E" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ScoreComparison, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="#2874E8" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="16" Padding="18,12">
                <StackPanel Spacing="0">
                    <TextBlock Text="Rubric breakdown" FontSize="18" FontWeight="SemiBold" Foreground="#14264F" Margin="4,0,0,8" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryScores, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:RubricCategoryScore">
                                <Grid Padding="6,8" ColumnSpacing="14" BorderBrush="#DFE6F2" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind CategoryName}" FontSize="13" FontWeight="SemiBold" Foreground="#1A2D55" />
                                        <TextBlock Text="{x:Bind EvaluationNotes}" FontSize="11" Foreground="#687B9C" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind PointsAwarded}" FontSize="13" FontWeight="SemiBold" Foreground="#1A2D55" />
                                        <TextBlock Text="/" Foreground="#687B9C" />
                                        <TextBlock Text="{x:Bind MaxPoints}" Foreground="#687B9C" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="2" Value="{x:Bind PointsAwarded}" Maximum="{x:Bind MaxPoints}" Height="10" VerticalAlignment="Center" Foreground="#70A0F2" Background="#E5EDFC" />
                                    <Border Grid.Column="3" Background="#FDE7E9" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Visibility="{x:Bind FixFirst}">
                                        <TextBlock Text="Fix first" FontSize="11" FontWeight="SemiBold" Foreground="#9B2634" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
