<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LIpstick_App.Pages.ScannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LIpstick.Core.Models"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="24" MaxWidth="1100" HorizontalAlignment="Left">

            <!-- Profile Summary & Scan Action Header -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <PersonPicture DisplayName="{x:Bind ViewModel.ProfileName, Mode=OneWay}" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ProfileName, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.ProfileHeadline, Mode=OneWay}" Opacity="0.75" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" Padding="16,8" Command="{x:Bind ViewModel.ScanProfileCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Foreground="White" />
                            <FontIcon Glyph="&#xE72C;" FontSize="14" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                            <TextBlock Text="Scan Profile" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Overall 100-Point Score Gauge -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Radial Circle / Score Display -->
                    <Border Width="100" Height="100" CornerRadius="50" BorderThickness="6" BorderBrush="#0A66C2" Background="#080A66C2" Margin="0,0,24,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.TotalScore, Mode=OneWay}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#0A66C2" />
                            <TextBlock Text="/ 100" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ScoreVerdict, Mode=OneWay}" FontSize="22" FontWeight="Bold" />
                            <Border Background="#200A66C2" CornerRadius="6" Padding="8,2">
                                <TextBlock Text="100-PT AUDIT" FontSize="10" FontWeight="Bold" Foreground="#0A66C2" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Evaluated against the authoritative 12-category rubric. The lowest-scoring categories are marked 'Fix first' below." Opacity="0.75" FontSize="13" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 12 Rubric Category Breakdown Grid -->
            <StackPanel Spacing="12">
                <TextBlock Text="Rubric Breakdown (12 Categories)" FontSize="18" FontWeight="SemiBold" />

                <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryScores, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" ItemWidth="340" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:RubricCategoryScore">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,16,16" MinHeight="110">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind CategoryName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Border Background="#FEE2E2" CornerRadius="4" Padding="6,2" Visibility="{x:Bind FixFirst}">
                                                <TextBlock Text="Fix first" Foreground="#991B1B" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{x:Bind PointsAwarded}" FontWeight="Bold" FontSize="14" Foreground="#0A66C2" />
                                            <TextBlock Text="/" Opacity="0.5" FontSize="14" />
                                            <TextBlock Text="{x:Bind MaxPoints}" Opacity="0.7" FontSize="14" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Text="{x:Bind EvaluationNotes}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
