<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LIpstick_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="#F3F6FD" Padding="26,22" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" MaxWidth="1080">
            <StackPanel Spacing="3" Margin="0,0,0,2">
                <TextBlock Text="Settings" FontSize="30" FontWeight="Bold" Foreground="#14264F" />
                <TextBlock Text="Manage your app preferences, AI models, and local data." FontSize="14" Foreground="#53678E" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="#2874E8" />

            <Border Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7F4;" FontSize="25" Foreground="#5274B4" />
                        <StackPanel Spacing="3"><TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" Foreground="#17284D" /><TextBlock Text="Choose how LIpstick looks." FontSize="11" Foreground="#667796" /></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Light" Command="{x:Bind ViewModel.SetThemeCommand}" CommandParameter="Light" Style="{x:Bind ViewModel.CurrentTheme, Mode=OneWay, Converter={StaticResource SectionTabStyleConverter}, ConverterParameter=Light}" />
                        <Button Content="Dark" Command="{x:Bind ViewModel.SetThemeCommand}" CommandParameter="Dark" Style="{x:Bind ViewModel.CurrentTheme, Mode=OneWay, Converter={StaticResource SectionTabStyleConverter}, ConverterParameter=Dark}" />
                        <Button Content="System" Command="{x:Bind ViewModel.SetThemeCommand}" CommandParameter="System" Style="{x:Bind ViewModel.CurrentTheme, Mode=OneWay, Converter={StaticResource SectionTabStyleConverter}, ConverterParameter=System}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
                        <FontIcon Glyph="&#xE713;" FontSize="25" Foreground="#5274B4" />
                        <StackPanel Spacing="3"><TextBlock Text="AI provider defaults" FontSize="15" FontWeight="SemiBold" Foreground="#17284D" /><TextBlock Text="Choose the model used for new drafts." FontSize="11" Foreground="#667796" /></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="10">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4"><TextBlock Text="Default model" FontSize="11" FontWeight="SemiBold" Foreground="#53678E" /><ComboBox ItemsSource="{x:Bind ViewModel.AvailableModels}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{x:Bind ViewModel.SelectedModel, Mode=TwoWay}" /></StackPanel>
                            <TextBlock Grid.Column="1" Text="Model availability follows your connected providers." FontSize="11" Foreground="#667796" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <Expander Header="Custom provider endpoints" IsExpanded="False">
                            <Grid ColumnSpacing="10" Padding="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBox Header="Gemini API endpoint URL" PlaceholderText="https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-latest:generateContent" Text="{x:Bind ViewModel.GeminiCustomBaseUrl, Mode=TwoWay}" />
                                <TextBox Grid.Column="1" Header="OpenAI API Endpoint URL" PlaceholderText="https://api.openai.com/v1" Text="{x:Bind ViewModel.OpenAiCustomBaseUrl, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Save endpoints" Command="{x:Bind ViewModel.SaveEndpointsCommand}" VerticalAlignment="Bottom" />
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72E;" FontSize="25" Foreground="#5274B4" />
                        <StackPanel Spacing="3"><TextBlock Text="Privacy &amp; data" FontSize="15" FontWeight="SemiBold" Foreground="#17284D" /><TextBlock Text="Your credentials and work stay on this device." FontSize="11" Foreground="#667796" /></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Provider keys are protected with Windows DPAPI. Your LinkedIn profile URL, imported Save to PDF text, public scan snapshots, suggestions, and drafts are stored locally. LIpstick never stores LinkedIn passwords or browser sessions." FontSize="12" Foreground="#53678E" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Local data location" FontSize="11" Foreground="#667796" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{x:Bind ViewModel.DataDirectory, Mode=OneWay}" IsReadOnly="True" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE74D;" FontSize="25" Foreground="#B44952" />
                        <StackPanel Spacing="3"><TextBlock Text="Export &amp; delete" FontSize="15" FontWeight="SemiBold" Foreground="#17284D" /><TextBlock Text="Manage your local LIpstick data." FontSize="11" Foreground="#667796" /></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="10">
                        <Button Content="Clear local data" Background="#FFF0F0" Foreground="#A32936" Click="ClearDataButton_Click" HorizontalAlignment="Left" />
                        <Border Background="#FFF0F0" CornerRadius="10" Padding="12,9">
                            <TextBlock Text="Clearing data permanently removes local history, settings, and protected credentials. This action cannot be undone." FontSize="11" Foreground="#87323B" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
