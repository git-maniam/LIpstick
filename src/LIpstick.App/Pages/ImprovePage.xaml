<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LIpstick_App.Pages.ImprovePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:LIpstick.Core.Services"
    mc:Ignorable="d">

    <Grid Padding="32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Section Selector Tabs -->
        <StackPanel Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Headline" Style="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource SectionTabStyleConverter}, ConverterParameter=Headline}" Command="{x:Bind ViewModel.SelectSectionCommand}" CommandParameter="Headline" />
                <Button Content="About Section" Style="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource SectionTabStyleConverter}, ConverterParameter=About}" Command="{x:Bind ViewModel.SelectSectionCommand}" CommandParameter="About" />
                <Button Content="Experience" Style="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource SectionTabStyleConverter}, ConverterParameter=Experience}" Command="{x:Bind ViewModel.SelectSectionCommand}" CommandParameter="Experience" />
            </StackPanel>
        </StackPanel>

        <!-- Split View: As-Is vs To-Be Side-by-Side -->
        <Grid Grid.Row="1" ColumnSpacing="20" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Current Live Profile (As-Is) -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="4" Margin="0,0,0,12">
                        <TextBlock Text="CURRENT LIVE PROFILE (As-Is)" FontSize="13" FontWeight="Bold" Opacity="0.6" />
                        <TextBlock Text="Read-only text imported from authenticated LinkedIn profile." FontSize="11" Opacity="0.5" />
                    </StackPanel>

                    <TextBox Grid.Row="1" Text="{x:Bind ViewModel.AsIsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" FontSize="14" />

                    <Border Grid.Row="2" Background="#08EF4444" BorderBrush="#20EF4444" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" Foreground="#EF4444" FontSize="14" />
                            <TextBlock Text="Missing verifiable metrics and outcome numbers." FontSize="12" Opacity="0.8" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Pane: Recommended Rewrite (To-Be) -->
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header with Live Humanizer Scorecard Pill -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="RECOMMENDED REWRITE (To-Be)" FontSize="13" FontWeight="Bold" Opacity="0.6" />
                            <TextBlock Text="Editable. Humanizer score recalculates in real-time." FontSize="11" Opacity="0.5" />
                        </StackPanel>

                        <!-- Live Humanizer Scorecard Pill with Tooltip -->
                        <Border Grid.Column="1" Background="#D1FAE5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                            <ToolTipService.ToolTip>
                                <StackPanel Spacing="6" Padding="6">
                                    <TextBlock Text="Heuristic 5-Check Detection Panel:" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Text="{x:Bind ViewModel.Burstiness, Mode=OneWay, Converter={StaticResource MetricFormatConverter}, ConverterParameter=Burstiness}" FontSize="11" />
                                    <TextBlock Text="{x:Bind ViewModel.Specificity, Mode=OneWay, Converter={StaticResource MetricFormatConverter}, ConverterParameter=Specificity}" FontSize="11" />
                                    <TextBlock Text="{x:Bind ViewModel.Slop, Mode=OneWay, Converter={StaticResource MetricFormatConverter}, ConverterParameter=Slop Density}" FontSize="11" />
                                    <TextBlock Text="{x:Bind ViewModel.Fingerprint, Mode=OneWay, Converter={StaticResource MetricFormatConverter}, ConverterParameter=Fingerprint}" FontSize="11" />
                                    <TextBlock Text="{x:Bind ViewModel.Voice, Mode=OneWay, Converter={StaticResource MetricFormatConverter}, ConverterParameter=Voice}" FontSize="11" />
                                </StackPanel>
                            </ToolTipService.ToolTip>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73E;" Foreground="#065F46" FontSize="12" />
                                <TextBlock Text="{x:Bind ViewModel.VerdictPillText, Mode=OneWay}" FontWeight="Bold" FontSize="12" Foreground="#065F46" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBox
                        x:Name="ToBeTextBox"
                        Grid.Row="1"
                        Text="{x:Bind ViewModel.ToBeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        FontSize="14"
                        TextChanged="ToBeTextBox_TextChanged" />

                    <!-- Bottom Metrics Quick Summary Bar -->
                    <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Burstiness" FontSize="10" Opacity="0.6" />
                                <ProgressBar Value="{x:Bind ViewModel.Burstiness, Mode=OneWay}" Maximum="100" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Specificity" FontSize="10" Opacity="0.6" />
                                <ProgressBar Value="{x:Bind ViewModel.Specificity, Mode=OneWay}" Maximum="100" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Slop" FontSize="10" Opacity="0.6" />
                                <ProgressBar Value="{x:Bind ViewModel.Slop, Mode=OneWay}" Maximum="100" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Fingerprint" FontSize="10" Opacity="0.6" />
                                <ProgressBar Value="{x:Bind ViewModel.Fingerprint, Mode=OneWay}" Maximum="100" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Voice" FontSize="10" Opacity="0.6" />
                                <ProgressBar Value="{x:Bind ViewModel.Voice, Mode=OneWay}" Maximum="100" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#0A66C2" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button Content="Clean &amp; De-Slop" Command="{x:Bind ViewModel.CleanAndHumanizeCommand}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="C" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button Content="Apply to LinkedIn" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.ApplyCommand}" IsEnabled="{x:Bind ViewModel.IsPass, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
