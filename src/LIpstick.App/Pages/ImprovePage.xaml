<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LIpstick_App.Pages.ImprovePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#F3F6FD" Padding="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="3" Margin="0,0,0,14">
            <TextBlock Text="Improve your profile" FontSize="30" FontWeight="Bold" Foreground="#14264F" />
            <TextBlock Text="Review one section at a time. Nothing changes on LinkedIn until you apply it." FontSize="14" Foreground="#53678E" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="14" Padding="8" Margin="0,0,0,14">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="Headline" Style="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource SectionTabStyleConverter}, ConverterParameter=Headline}" Command="{x:Bind ViewModel.SelectSectionCommand}" CommandParameter="Headline" HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Content="About" Style="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource SectionTabStyleConverter}, ConverterParameter=About}" Command="{x:Bind ViewModel.SelectSectionCommand}" CommandParameter="About" HorizontalAlignment="Stretch" />
                <Button Grid.Column="2" Content="Experience" Style="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource SectionTabStyleConverter}, ConverterParameter=Experience}" Command="{x:Bind ViewModel.SelectSectionCommand}" CommandParameter="Experience" HorizontalAlignment="Stretch" />
                <Button Grid.Column="3" Content="Featured" Style="{x:Bind ViewModel.SelectedSection, Mode=OneWay, Converter={StaticResource SectionTabStyleConverter}, ConverterParameter=Featured}" Command="{x:Bind ViewModel.SelectSectionCommand}" CommandParameter="Featured" HorizontalAlignment="Stretch" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="14" MinHeight="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="#E7EEFF" CornerRadius="14" Padding="12,6" HorizontalAlignment="Left">
                        <TextBlock Text="AS-IS · CURRENT PROFILE" FontSize="12" FontWeight="Bold" Foreground="#284578" />
                    </Border>
                    <TextBox Grid.Row="1" Text="{x:Bind ViewModel.AsIsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14" />
                    <Border Grid.Row="2" Background="#FFF0F0" CornerRadius="12" Padding="11,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" Foreground="#B33A46" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#87323B" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="14" Padding="18">
                <Grid RowSpacing="11">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <Border Background="#DDF4F1" CornerRadius="14" Padding="12,6" HorizontalAlignment="Left">
                                <TextBlock Text="TO-BE · RECOMMENDED" FontSize="12" FontWeight="Bold" Foreground="#1B615B" />
                            </Border>
                            <TextBlock Text="Editable draft. Your original profile stays unchanged until you apply." FontSize="11" Foreground="#667796" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#DDF4E8" CornerRadius="14" Padding="12,7" VerticalAlignment="Center">
                            <ToolTipService.ToolTip>
                                <StackPanel Spacing="5" Padding="6">
                                    <TextBlock Text="Humanizer checks" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind ViewModel.Burstiness, Mode=OneWay, Converter={StaticResource MetricFormatConverter}, ConverterParameter=Burstiness}" />
                                    <TextBlock Text="{x:Bind ViewModel.Specificity, Mode=OneWay, Converter={StaticResource MetricFormatConverter}, ConverterParameter=Specificity}" />
                                    <TextBlock Text="{x:Bind ViewModel.Slop, Mode=OneWay, Converter={StaticResource MetricFormatConverter}, ConverterParameter=Slop}" />
                                    <TextBlock Text="{x:Bind ViewModel.Fingerprint, Mode=OneWay, Converter={StaticResource MetricFormatConverter}, ConverterParameter=Fingerprint}" />
                                    <TextBlock Text="{x:Bind ViewModel.Voice, Mode=OneWay, Converter={StaticResource MetricFormatConverter}, ConverterParameter=Voice}" />
                                </StackPanel>
                            </ToolTipService.ToolTip>
                            <TextBlock Text="{x:Bind ViewModel.VerdictPillText, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="#155E47" />
                        </Border>
                    </Grid>
                    <TextBox x:Name="ToBeTextBox" Grid.Row="1" Text="{x:Bind ViewModel.ToBeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14" TextChanged="ToBeTextBox_TextChanged" />
                    <Grid Grid.Row="2" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Burstiness" FontSize="10" Foreground="#53678E" /><ProgressBar Value="{x:Bind ViewModel.Burstiness, Mode=OneWay}" Maximum="100" Foreground="#72A0F2" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Specificity" FontSize="10" Foreground="#53678E" /><ProgressBar Value="{x:Bind ViewModel.Specificity, Mode=OneWay}" Maximum="100" Foreground="#72A0F2" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Slop" FontSize="10" Foreground="#53678E" /><ProgressBar Value="{x:Bind ViewModel.Slop, Mode=OneWay}" Maximum="100" Foreground="#72A0F2" /></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="Fingerprint" FontSize="10" Foreground="#53678E" /><ProgressBar Value="{x:Bind ViewModel.Fingerprint, Mode=OneWay}" Maximum="100" Foreground="#72A0F2" /></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Voice" FontSize="10" Foreground="#53678E" /><ProgressBar Value="{x:Bind ViewModel.Voice, Mode=OneWay}" Maximum="100" Foreground="#72A0F2" /></StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Regenerate" Command="{x:Bind ViewModel.ReGenerateCommand}" />
                        <Button Content="Apply this section" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.ApplyCommand}" IsEnabled="{x:Bind ViewModel.IsPass, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12" Foreground="#53678E" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind ViewModel.GenerationMetadata, Mode=OneWay}" FontSize="10" Foreground="#71819C" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
