<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="LIpstick_App.Pages.ContentLabPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LIpstick.Core.Models"
    mc:Ignorable="d">

    <Grid Background="#F3F6FD" Padding="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="3" Margin="0,0,0,12">
            <TextBlock Text="Content Lab" FontSize="30" FontWeight="Bold" Foreground="#14264F" />
            <TextBlock Text="Create, refine, and repurpose content for LinkedIn." FontSize="14" Foreground="#53678E" />
        </StackPanel>
        <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,14">
            <GridView ItemsSource="{x:Bind ViewModel.Skills, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedSkill, Mode=TwoWay}" SelectionMode="Single" IsItemClickEnabled="False" Height="92" HorizontalAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollMode="Disabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" ItemWidth="156" ItemHeight="40" /></ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:SkillToolDefinition">
                        <Border Background="#FFFFFF" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="3">
                            <TextBlock Text="{x:Bind NavigationLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#233B69" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <Border Background="#FFF0F0" BorderBrush="#F4D3D6" BorderThickness="1" CornerRadius="10" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7BA;" Foreground="#B33A46" FontSize="14" />
                    <TextBlock Text="Nothing is posted or sent automatically. Review every draft before copying or using it." FontSize="12" Foreground="#87323B" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Background="#E7EEFF" CornerRadius="10" Padding="10,6" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8A5;" Foreground="#2874E8" /><TextBlock Text="{x:Bind ViewModel.ActiveToolTitle, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="#1A315F" /></StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <TextBox Header="{x:Bind ViewModel.InputOneHeader, Mode=OneWay}" PlaceholderText="Enter information you can verify." Text="{x:Bind ViewModel.InputOne, Mode=TwoWay}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" />
                            <TextBox Header="{x:Bind ViewModel.InputTwoHeader, Mode=OneWay}" Text="{x:Bind ViewModel.InputTwo, Mode=TwoWay}" AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HideInputTwo, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                            <TextBox Header="{x:Bind ViewModel.InputThreeHeader, Mode=OneWay}" Text="{x:Bind ViewModel.InputThree, Mode=TwoWay}" AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HideInputThree, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                            <TextBox Header="{x:Bind ViewModel.InputFourHeader, Mode=OneWay}" Text="{x:Bind ViewModel.InputFour, Mode=TwoWay}" AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HideInputFour, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                            <TextBox Header="{x:Bind ViewModel.InputFiveHeader, Mode=OneWay}" Text="{x:Bind ViewModel.InputFive, Mode=TwoWay}" AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap" Visibility="{x:Bind ViewModel.HideInputFive, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="11" Foreground="#2874E8" TextWrapping="Wrap" />
                        <Button Content="Run tool" Style="{ThemeResource AccentButtonStyle}" Command="{x:Bind ViewModel.GenerateSelectedSkillCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#D9E3F4" BorderThickness="1" CornerRadius="14" Padding="16">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="Output · not sent" FontSize="15" FontWeight="SemiBold" Foreground="#1A315F" />
                        <TextBlock Text="Review the analysis or edit the draft before using it." FontSize="11" Foreground="#667796" />
                    </StackPanel>
                    <TextBox Grid.Row="1" Text="{x:Bind ViewModel.ResultText, Mode=TwoWay}" PlaceholderText="This tool's output will appear here." TextWrapping="Wrap" AcceptsReturn="True" MinHeight="200" />
                    <TextBlock Grid.Row="2" Text="Nothing is posted or sent automatically." FontSize="11" Foreground="#667796" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
